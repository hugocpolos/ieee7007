                                                                                                                        <swrl:classPredicate rdf:resource="https://w3id.org/ieee7007/evm#SocioTechnologyGovernance"/>
                                                                                                                        <swrl:argument1 rdf:resource="urn:swrl:var#mg"/>
                                                                                                                    </rdf:Description>
