<?xml version="1.0"?>
<rdf:RDF xmlns="https://w3id.org/ieee7007/evm#"
     xml:base="https://w3id.org/ieee7007/evm"
     xmlns:dc="http://purl.org/dc/elements/1.1/"
     xmlns:evm="https://w3id.org/ieee7007/evm#"
     xmlns:nep="https://w3id.org/ieee7007/nep#"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:tlo="https://w3id.org/ieee7007/tlo#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:swrl="http://www.w3.org/2003/11/swrl#"
     xmlns:swrlb="http://www.w3.org/2003/11/swrlb#">
    <owl:Ontology rdf:about="https://w3id.org/ieee7007/evm">
        <owl:versionIRI rdf:resource="https://w3id.org/ieee7007/0.3.1/evm"/>
        <owl:imports rdf:resource="https://w3id.org/ieee7007/nep"/>
        <owl:imports rdf:resource="https://w3id.org/ieee7007/tlo"/>
        <rdfs:comment>An example mapping of ERAS-EVM CLIF axioms into OWL axioms using Manchester OWL syntax</rdfs:comment>
    </owl:Ontology>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Annotation properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.w3.org/2000/01/rdf-schema#comment -->

    <owl:AnnotationProperty rdf:about="http://www.w3.org/2000/01/rdf-schema#comment"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- https://w3id.org/ieee7007/evm#actor -->

    <owl:ObjectProperty rdf:about="https://w3id.org/ieee7007/evm#actor">
        <rdfs:domain rdf:resource="https://w3id.org/ieee7007/evm#EventCausation"/>
        <rdfs:range rdf:resource="https://w3id.org/ieee7007/nep#nepAgent"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ieee7007/evm#ascribes -->

    <owl:ObjectProperty rdf:about="https://w3id.org/ieee7007/evm#ascribes">
        <rdfs:domain rdf:resource="https://w3id.org/ieee7007/nep#nepAgent"/>
        <rdfs:range rdf:resource="https://w3id.org/ieee7007/evm#ResponsibilityAscription"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ieee7007/evm#ascribes_distributed_responsibility_in -->

    <owl:ObjectProperty rdf:about="https://w3id.org/ieee7007/evm#ascribes_distributed_responsibility_in">
        <rdfs:domain rdf:resource="https://w3id.org/ieee7007/evm#ResponsibilityAscription"/>
        <rdfs:range rdf:resource="https://w3id.org/ieee7007/evm#ResponsibilityAscription"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ieee7007/evm#cause -->

    <owl:ObjectProperty rdf:about="https://w3id.org/ieee7007/evm#cause">
        <rdfs:domain rdf:resource="https://w3id.org/ieee7007/evm#EventCausation"/>
        <rdfs:range rdf:resource="https://w3id.org/ieee7007/nep#AgentAction"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ieee7007/evm#composed_of -->

    <owl:ObjectProperty rdf:about="https://w3id.org/ieee7007/evm#composed_of">
        <rdfs:domain rdf:resource="https://w3id.org/ieee7007/evm#AscriptionJustification"/>
        <rdfs:range rdf:resource="https://w3id.org/ieee7007/evm#GroundsForAscription"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ieee7007/evm#contributes_to -->

    <owl:ObjectProperty rdf:about="https://w3id.org/ieee7007/evm#contributes_to">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/ieee7007/evm#AgentAccountability"/>
                    <rdf:Description rdf:about="https://w3id.org/ieee7007/evm#EventCausation"/>
                    <rdf:Description rdf:about="https://w3id.org/ieee7007/evm#NormViolationIncident"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="https://w3id.org/ieee7007/evm#GroundsForAscription"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ieee7007/evm#detects -->

    <owl:ObjectProperty rdf:about="https://w3id.org/ieee7007/evm#detects">
        <rdfs:domain rdf:resource="https://w3id.org/ieee7007/evm#EthicalBehaviorMonitor"/>
        <rdfs:range rdf:resource="https://w3id.org/ieee7007/evm#NormViolation"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ieee7007/evm#documented_in -->

    <owl:ObjectProperty rdf:about="https://w3id.org/ieee7007/evm#documented_in">
        <rdfs:domain rdf:resource="https://w3id.org/ieee7007/evm#NormViolation"/>
        <rdfs:range rdf:resource="https://w3id.org/ieee7007/evm#NormViolationIncident"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ieee7007/evm#effect -->

    <owl:ObjectProperty rdf:about="https://w3id.org/ieee7007/evm#effect">
        <rdfs:domain rdf:resource="https://w3id.org/ieee7007/evm#EventCausation"/>
        <rdfs:range rdf:resource="https://w3id.org/ieee7007/evm#NormViolation"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ieee7007/evm#elicits -->

    <owl:ObjectProperty rdf:about="https://w3id.org/ieee7007/evm#elicits">
        <rdfs:domain rdf:resource="https://w3id.org/ieee7007/evm#NormViolation"/>
        <rdfs:range rdf:resource="https://w3id.org/ieee7007/evm#ResponsibilityAscription"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ieee7007/evm#has_achieved -->

    <owl:ObjectProperty rdf:about="https://w3id.org/ieee7007/evm#has_achieved">
        <rdfs:domain rdf:resource="https://w3id.org/ieee7007/nep#Government"/>
        <rdfs:range rdf:resource="https://w3id.org/ieee7007/evm#SocioTechnologyGovernance"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ieee7007/evm#imposes -->

    <owl:ObjectProperty rdf:about="https://w3id.org/ieee7007/evm#imposes">
        <rdfs:domain rdf:resource="https://w3id.org/ieee7007/nep#AgentRole"/>
        <rdfs:range rdf:resource="https://w3id.org/ieee7007/evm#AgentAccountability"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ieee7007/evm#is_ascribed_to -->

    <owl:ObjectProperty rdf:about="https://w3id.org/ieee7007/evm#is_ascribed_to">
        <rdfs:domain rdf:resource="https://w3id.org/ieee7007/evm#ResponsibilityAscription"/>
        <rdfs:range rdf:resource="https://w3id.org/ieee7007/nep#nepAgent"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ieee7007/evm#is_jurisdiction_of -->

    <owl:ObjectProperty rdf:about="https://w3id.org/ieee7007/evm#is_jurisdiction_of">
        <rdfs:domain rdf:resource="https://w3id.org/ieee7007/nep#Government"/>
        <rdfs:range rdf:resource="https://w3id.org/ieee7007/nep#nepAgent"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ieee7007/evm#is_sanction_for -->

    <owl:ObjectProperty rdf:about="https://w3id.org/ieee7007/evm#is_sanction_for">
        <rdfs:domain rdf:resource="https://w3id.org/ieee7007/evm#LiabilitySanction"/>
        <rdfs:range rdf:resource="https://w3id.org/ieee7007/evm#LegalResponsibilityAscription"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ieee7007/evm#is_violation_of -->

    <owl:ObjectProperty rdf:about="https://w3id.org/ieee7007/evm#is_violation_of">
        <rdfs:domain rdf:resource="https://w3id.org/ieee7007/evm#NormViolation"/>
        <rdfs:range rdf:resource="https://w3id.org/ieee7007/nep#Norm"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ieee7007/evm#justifies -->

    <owl:ObjectProperty rdf:about="https://w3id.org/ieee7007/evm#justifies">
        <rdfs:domain rdf:resource="https://w3id.org/ieee7007/evm#AscriptionJustification"/>
        <rdfs:range rdf:resource="https://w3id.org/ieee7007/evm#ResponsibilityAscription"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ieee7007/evm#maturity -->

    <owl:ObjectProperty rdf:about="https://w3id.org/ieee7007/evm#maturity">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/ieee7007/evm#SocioTechnologyGovernance"/>
        <rdfs:range rdf:resource="https://w3id.org/ieee7007/evm#governance_levels"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ieee7007/evm#may_be_sanctioned_with -->

    <owl:ObjectProperty rdf:about="https://w3id.org/ieee7007/evm#may_be_sanctioned_with">
        <rdfs:domain rdf:resource="https://w3id.org/ieee7007/nep#nepAgent"/>
        <rdfs:range rdf:resource="https://w3id.org/ieee7007/evm#LiabilitySanction"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ieee7007/evm#may_prescribe -->

    <owl:ObjectProperty rdf:about="https://w3id.org/ieee7007/evm#may_prescribe">
        <rdfs:domain rdf:resource="https://w3id.org/ieee7007/evm#LegalResponsibilityAscription"/>
        <rdfs:range rdf:resource="https://w3id.org/ieee7007/evm#LiabilitySanction"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ieee7007/evm#observes -->

    <owl:ObjectProperty rdf:about="https://w3id.org/ieee7007/evm#observes">
        <rdfs:domain rdf:resource="https://w3id.org/ieee7007/evm#EthicalBehaviorMonitor"/>
        <rdfs:range rdf:resource="https://w3id.org/ieee7007/nep#nepAgent"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ieee7007/evm#perceived_in -->

    <owl:ObjectProperty rdf:about="https://w3id.org/ieee7007/evm#perceived_in">
        <rdfs:domain rdf:resource="https://w3id.org/ieee7007/tlo#ActionEvent"/>
        <rdfs:range rdf:resource="https://w3id.org/ieee7007/nep#nepSituation"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ieee7007/evm#records_incidence_of -->

    <owl:ObjectProperty rdf:about="https://w3id.org/ieee7007/evm#records_incidence_of">
        <rdfs:domain rdf:resource="https://w3id.org/ieee7007/evm#NormViolationIncident"/>
        <rdfs:range rdf:resource="https://w3id.org/ieee7007/evm#NormViolation"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ieee7007/evm#scope -->

    <owl:ObjectProperty rdf:about="https://w3id.org/ieee7007/evm#scope">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/ieee7007/evm#ResponsibilityAscription"/>
        <rdfs:range rdf:resource="https://w3id.org/ieee7007/evm#responsibility_extent"/>
    </owl:ObjectProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- https://w3id.org/ieee7007/evm#AccountablePerson -->

    <owl:Class rdf:about="https://w3id.org/ieee7007/evm#AccountablePerson">
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/ieee7007/nep#nepAgent"/>
                    <owl:Class>
                        <owl:complementOf rdf:resource="https://w3id.org/ieee7007/nep#Robot"/>
                    </owl:Class>
                    <owl:Restriction>
                        <owl:onProperty>
                            <rdf:Description>
                                <owl:inverseOf rdf:resource="https://w3id.org/ieee7007/evm#is_ascribed_to"/>
                            </rdf:Description>
                        </owl:onProperty>
                        <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
                        <owl:onClass rdf:resource="https://w3id.org/ieee7007/evm#ResponsibilityAscription"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <rdfs:comment>helper class for mapping CLIF axioms</rdfs:comment>
    </owl:Class>
    


    <!-- https://w3id.org/ieee7007/evm#AgentAccountability -->

    <owl:Class rdf:about="https://w3id.org/ieee7007/evm#AgentAccountability">
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/ieee7007/tlo#Schema"/>
                    <owl:Restriction>
                        <owl:onProperty>
                            <rdf:Description>
                                <owl:inverseOf rdf:resource="https://w3id.org/ieee7007/evm#imposes"/>
                            </rdf:Description>
                        </owl:onProperty>
                        <owl:someValuesFrom rdf:resource="https://w3id.org/ieee7007/nep#AgentRole"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- https://w3id.org/ieee7007/evm#AscriptionJustification -->

    <owl:Class rdf:about="https://w3id.org/ieee7007/evm#AscriptionJustification">
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/ieee7007/tlo#InformationArtifact"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://w3id.org/ieee7007/evm#justifies"/>
                        <owl:someValuesFrom rdf:resource="https://w3id.org/ieee7007/evm#ResponsibilityAscription"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty>
                            <rdf:Description>
                                <owl:inverseOf rdf:resource="https://w3id.org/ieee7007/tlo#formulates"/>
                            </rdf:Description>
                        </owl:onProperty>
                        <owl:someValuesFrom rdf:resource="https://w3id.org/ieee7007/nep#nepAgent"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://w3id.org/ieee7007/evm#composed_of"/>
                        <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
                        <owl:onClass rdf:resource="https://w3id.org/ieee7007/evm#GroundsForAscription"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- https://w3id.org/ieee7007/evm#DistributedResponsibility -->

    <owl:Class rdf:about="https://w3id.org/ieee7007/evm#DistributedResponsibility">
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/ieee7007/evm#ResponsibilityAscription"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://w3id.org/ieee7007/evm#scope"/>
                        <owl:hasValue rdf:resource="https://w3id.org/ieee7007/evm#multi_agents"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://w3id.org/ieee7007/evm#ascribes_distributed_responsibility_in"/>
                        <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
                        <owl:onClass rdf:resource="https://w3id.org/ieee7007/evm#ResponsibilityAscription"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <rdfs:comment>helper class for mapping CLIF axioms</rdfs:comment>
    </owl:Class>
    


    <!-- https://w3id.org/ieee7007/evm#evmEnumDataTypes -->

    <owl:Class rdf:about="https://w3id.org/ieee7007/evm#evmEnumDataTypes">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ieee7007/tlo#tloEnumDataTypes"/>
    </owl:Class>
    


    <!-- https://w3id.org/ieee7007/evm#EthicalBehaviorMonitor -->

    <owl:Class rdf:about="https://w3id.org/ieee7007/evm#EthicalBehaviorMonitor">
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/ieee7007/tlo#evmObject"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://w3id.org/ieee7007/evm#observes"/>
                        <owl:someValuesFrom rdf:resource="https://w3id.org/ieee7007/nep#nepAgent"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://w3id.org/ieee7007/evm#detects"/>
                        <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minQualifiedCardinality>
                        <owl:onClass rdf:resource="https://w3id.org/ieee7007/evm#NormViolation"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- https://w3id.org/ieee7007/evm#EthicalResponsibilityAscription -->

    <owl:Class rdf:about="https://w3id.org/ieee7007/evm#EthicalResponsibilityAscription">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ieee7007/evm#ResponsibilityAscription"/>
        <owl:disjointWith rdf:resource="https://w3id.org/ieee7007/evm#LegalResponsibilityAscription"/>
    </owl:Class>
    


    <!-- https://w3id.org/ieee7007/evm#EventCausation -->

    <owl:Class rdf:about="https://w3id.org/ieee7007/evm#EventCausation">
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/ieee7007/tlo#InteractionProcess"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://w3id.org/ieee7007/evm#actor"/>
                        <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
                        <owl:onClass rdf:resource="https://w3id.org/ieee7007/nep#nepAgent"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://w3id.org/ieee7007/evm#cause"/>
                        <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
                        <owl:onClass rdf:resource="https://w3id.org/ieee7007/nep#AgentAction"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://w3id.org/ieee7007/evm#effect"/>
                        <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
                        <owl:onClass rdf:resource="https://w3id.org/ieee7007/evm#NormViolation"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- https://w3id.org/ieee7007/evm#GroundsForAscription -->

    <owl:Class rdf:about="https://w3id.org/ieee7007/evm#GroundsForAscription">
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/ieee7007/tlo#InformationArtifact"/>
                    <owl:Restriction>
                        <owl:onProperty>
                            <rdf:Description>
                                <owl:inverseOf rdf:resource="https://w3id.org/ieee7007/evm#contributes_to"/>
                            </rdf:Description>
                        </owl:onProperty>
                        <owl:someValuesFrom rdf:resource="https://w3id.org/ieee7007/evm#AgentAccountability"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty>
                            <rdf:Description>
                                <owl:inverseOf rdf:resource="https://w3id.org/ieee7007/evm#contributes_to"/>
                            </rdf:Description>
                        </owl:onProperty>
                        <owl:someValuesFrom rdf:resource="https://w3id.org/ieee7007/evm#EventCausation"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty>
                            <rdf:Description>
                                <owl:inverseOf rdf:resource="https://w3id.org/ieee7007/evm#contributes_to"/>
                            </rdf:Description>
                        </owl:onProperty>
                        <owl:someValuesFrom rdf:resource="https://w3id.org/ieee7007/evm#NormViolationIncident"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- https://w3id.org/ieee7007/evm#LegalResponsibilityAscription -->

    <owl:Class rdf:about="https://w3id.org/ieee7007/evm#LegalResponsibilityAscription">
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/ieee7007/evm#ResponsibilityAscription"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://w3id.org/ieee7007/evm#may_prescribe"/>
                        <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minQualifiedCardinality>
                        <owl:onClass rdf:resource="https://w3id.org/ieee7007/evm#LegalResponsibilityAscription"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- https://w3id.org/ieee7007/evm#LiabilitySanction -->

    <owl:Class rdf:about="https://w3id.org/ieee7007/evm#LiabilitySanction">
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/ieee7007/tlo#Method"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://w3id.org/ieee7007/evm#is_sanction_for"/>
                        <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minQualifiedCardinality>
                        <owl:onClass rdf:resource="https://w3id.org/ieee7007/evm#LegalResponsibilityAscription"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- https://w3id.org/ieee7007/evm#NormViolation -->

    <owl:Class rdf:about="https://w3id.org/ieee7007/evm#NormViolation">
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/ieee7007/tlo#ActionEvent"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://w3id.org/ieee7007/evm#documented_in"/>
                        <owl:someValuesFrom rdf:resource="https://w3id.org/ieee7007/evm#NormViolationIncident"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://w3id.org/ieee7007/evm#elicits"/>
                        <owl:someValuesFrom rdf:resource="https://w3id.org/ieee7007/evm#ResponsibilityAscription"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://w3id.org/ieee7007/evm#is_violation_of"/>
                        <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
                        <owl:onClass rdf:resource="https://w3id.org/ieee7007/nep#Norm"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty>
                            <rdf:Description>
                                <owl:inverseOf rdf:resource="https://w3id.org/ieee7007/evm#effect"/>
                            </rdf:Description>
                        </owl:onProperty>
                        <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
                        <owl:onClass rdf:resource="https://w3id.org/ieee7007/evm#EventCausation"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- https://w3id.org/ieee7007/evm#NormViolationIncident -->

    <owl:Class rdf:about="https://w3id.org/ieee7007/evm#NormViolationIncident">
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/ieee7007/tlo#InformationArtifact"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://w3id.org/ieee7007/evm#records_incidence_of"/>
                        <owl:someValuesFrom rdf:resource="https://w3id.org/ieee7007/evm#NormViolation"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- https://w3id.org/ieee7007/evm#ResponsibilityAscription -->

    <owl:Class rdf:about="https://w3id.org/ieee7007/evm#ResponsibilityAscription">
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/ieee7007/tlo#SocialInteractionProcess"/>
                    <owl:Restriction>
                        <owl:onProperty>
                            <rdf:Description>
                                <owl:inverseOf rdf:resource="https://w3id.org/ieee7007/evm#justifies"/>
                            </rdf:Description>
                        </owl:onProperty>
                        <owl:someValuesFrom rdf:resource="https://w3id.org/ieee7007/evm#AscriptionJustification"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://w3id.org/ieee7007/evm#ascribes_distributed_responsibility_in"/>
                        <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minQualifiedCardinality>
                        <owl:onClass rdf:resource="https://w3id.org/ieee7007/evm#ResponsibilityAscription"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://w3id.org/ieee7007/evm#is_ascribed_to"/>
                        <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
                        <owl:onClass rdf:resource="https://w3id.org/ieee7007/nep#nepAgent"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty>
                            <rdf:Description>
                                <owl:inverseOf rdf:resource="https://w3id.org/ieee7007/evm#ascribes"/>
                            </rdf:Description>
                        </owl:onProperty>
                        <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
                        <owl:onClass rdf:resource="https://w3id.org/ieee7007/nep#nepAgent"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- https://w3id.org/ieee7007/evm#SocioTechnologyGovernance -->

    <owl:Class rdf:about="https://w3id.org/ieee7007/evm#SocioTechnologyGovernance">
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/ieee7007/tlo#InteractionProcess"/>
                    <owl:Restriction>
                        <owl:onProperty>
                            <rdf:Description>
                                <owl:inverseOf rdf:resource="https://w3id.org/ieee7007/evm#has_achieved"/>
                            </rdf:Description>
                        </owl:onProperty>
                        <owl:someValuesFrom rdf:resource="https://w3id.org/ieee7007/nep#Government"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://w3id.org/ieee7007/evm#maturity"/>
                        <owl:allValuesFrom>
                            <owl:Class>
                                <owl:oneOf rdf:parseType="Collection">
                                    <rdf:Description rdf:about="https://w3id.org/ieee7007/evm#certified_high_capacity"/>
                                    <rdf:Description rdf:about="https://w3id.org/ieee7007/evm#evolving_capacity"/>
                                    <rdf:Description rdf:about="https://w3id.org/ieee7007/evm#no_capacity"/>
                                </owl:oneOf>
                            </owl:Class>
                        </owl:allValuesFrom>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- https://w3id.org/ieee7007/evm#governance_levels -->

    <owl:Class rdf:about="https://w3id.org/ieee7007/evm#governance_levels">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ieee7007/evm#evmEnumDataTypes"/>
        <rdfs:comment>Governance maturity levels </rdfs:comment>
        <rdfs:comment>{ no_capacity, evolving_capacity, certified_high_capacity }</rdfs:comment>
    </owl:Class>
    


    <!-- https://w3id.org/ieee7007/evm#legal_liabilities -->

    <owl:Class rdf:about="https://w3id.org/ieee7007/evm#legal_liabilities">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ieee7007/evm#evmEnumDataTypes"/>
        <rdfs:comment>examples of Legal Liabilities</rdfs:comment>
        <rdfs:comment>{ fine, penalty, restitution, suspension, restriction, demotion, expulsion, instruction, civic_service, incarceration, execution }</rdfs:comment>
    </owl:Class>
    


    <!-- https://w3id.org/ieee7007/evm#responsibility_extent -->

    <owl:Class rdf:about="https://w3id.org/ieee7007/evm#responsibility_extent">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ieee7007/evm#evmEnumDataTypes"/>
        <rdfs:comment>Responsibility Extent</rdfs:comment>
        <rdfs:comment>{ single_agent, multi_agents }</rdfs:comment>
    </owl:Class>
    


