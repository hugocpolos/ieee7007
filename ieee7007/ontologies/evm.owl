    <!-- https://w3id.org/ieee7007/evm#evmResponsibilityAscription -->

    <owl:Class rdf:about="https://w3id.org/ieee7007/evm#evmResponsibilityAscription">
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/ieee7007/tlo#tloSocialInteractionProcess"/>
                    <owl:Restriction>
                        <owl:onProperty>
                            <rdf:Description>
                                <owl:inverseOf rdf:resource="https://w3id.org/ieee7007/evm#evmjustifies"/>
                            </rdf:Description>
                        </owl:onProperty>
                        <owl:someValuesFrom rdf:resource="https://w3id.org/ieee7007/evm#evmAscriptionJustification"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://w3id.org/ieee7007/evm#evmascribes_distributed_responsibility_in"/>
                        <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minQualifiedCardinality>
                        <owl:onClass rdf:resource="https://w3id.org/ieee7007/evm#evmResponsibilityAscription"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://w3id.org/ieee7007/evm#evmis_ascribed_to"/>
                        <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
                        <owl:onClass rdf:resource="https://w3id.org/ieee7007/nep#nepAgent"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty>
                            <rdf:Description>
                                <owl:inverseOf rdf:resource="https://w3id.org/ieee7007/evm#evmascribes"/>
                            </rdf:Description>
                        </owl:onProperty>
                        <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
                        <owl:onClass rdf:resource="https://w3id.org/ieee7007/nep#nepAgent"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- https://w3id.org/ieee7007/evm#evmSocioTechnologyGovernance -->

    <owl:Class rdf:about="https://w3id.org/ieee7007/evm#evmSocioTechnologyGovernance">
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/ieee7007/tlo#tloInteractionProcess"/>
                    <owl:Restriction>
                        <owl:onProperty>
                            <rdf:Description>
                                <owl:inverseOf rdf:resource="https://w3id.org/ieee7007/evm#evmhas_achieved"/>
                            </rdf:Description>
                        </owl:onProperty>
                        <owl:someValuesFrom rdf:resource="https://w3id.org/ieee7007/nep#nepGovernment"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://w3id.org/ieee7007/evm#evmmaturity"/>
                        <owl:allValuesFrom>
                            <owl:Class>
                                <owl:oneOf rdf:parseType="Collection">
                                    <rdf:Description rdf:about="https://w3id.org/ieee7007/evm#evmcertified_high_capacity"/>
                                    <rdf:Description rdf:about="https://w3id.org/ieee7007/evm#evmevolving_capacity"/>
                                    <rdf:Description rdf:about="https://w3id.org/ieee7007/evm#evmno_capacity"/>
                                </owl:oneOf>
                            </owl:Class>
                        </owl:allValuesFrom>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- https://w3id.org/ieee7007/evm#evmgovernance_levels -->

    <owl:Class rdf:about="https://w3id.org/ieee7007/evm#evmgovernance_levels">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ieee7007/evm#evmEnumDataTypes"/>
        <rdfs:comment>Governance maturity levels </rdfs:comment>
        <rdfs:comment>{ no_capacity, evolving_capacity, certified_high_capacity }</rdfs:comment>
    </owl:Class>
    


    <!-- https://w3id.org/ieee7007/evm#evmlegal_liabilities -->

    <owl:Class rdf:about="https://w3id.org/ieee7007/evm#evmlegal_liabilities">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ieee7007/evm#evmEnumDataTypes"/>
        <rdfs:comment>examples of Legal Liabilities</rdfs:comment>
        <rdfs:comment>{ fine, penalty, restitution, suspension, restriction, demotion, expulsion, instruction, civic_service, incarceration, execution }</rdfs:comment>
    </owl:Class>
    


    <!-- https://w3id.org/ieee7007/evm#evmresponsibility_extent -->

    <owl:Class rdf:about="https://w3id.org/ieee7007/evm#evmresponsibility_extent">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ieee7007/evm#evmEnumDataTypes"/>
        <rdfs:comment>Responsibility Extent</rdfs:comment>
        <rdfs:comment>{ single_agent, multi_agents }</rdfs:comment>
    </owl:Class>
    


