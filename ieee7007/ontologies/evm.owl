                                                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/>
                                                                <swrl:propertyPredicate rdf:resource="https://w3id.org/ieee7007/tlo#is_member_of"/>
                                                                <swrl:argument1 rdf:resource="urn:swrl:var#h"/>
                                                                <swrl:argument2 rdf:resource="urn:swrl:var#t"/>
