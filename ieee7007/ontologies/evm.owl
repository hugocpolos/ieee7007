<?xml version="1.0"?>
<rdf:RDF xmlns="https://w3id.org/ieee7007/evm#"
     xml:base="https://w3id.org/ieee7007/evm"
     xmlns:dc="http://purl.org/dc/elements/1.1/"
     xmlns:evm="https://w3id.org/ieee7007/evm#"
     xmlns:nep="https://w3id.org/ieee7007/nep#"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:tlo="https://w3id.org/ieee7007/tlo#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:swrl="http://www.w3.org/2003/11/swrl#"
     xmlns:swrlb="http://www.w3.org/2003/11/swrlb#">
    <owl:Ontology rdf:about="https://w3id.org/ieee7007/evm">
        <owl:versionIRI rdf:resource="https://w3id.org/ieee7007/0.3.0/evm"/>
        <owl:imports rdf:resource="https://w3id.org/ieee7007/nep"/>
        <owl:imports rdf:resource="https://w3id.org/ieee7007/tlo"/>
        <rdfs:comment>An example mapping of ERAS-EVM CLIF axioms into OWL axioms using Manchester OWL syntax</rdfs:comment>
    </owl:Ontology>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Annotation properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.w3.org/2000/01/rdf-schema#comment -->

    <owl:AnnotationProperty rdf:about="http://www.w3.org/2000/01/rdf-schema#comment"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- https://w3id.org/ieee7007/evm#evmactor -->

    <owl:ObjectProperty rdf:about="https://w3id.org/ieee7007/evm#evmactor">
        <rdfs:domain rdf:resource="https://w3id.org/ieee7007/evm#evmEventCausation"/>
        <rdfs:range rdf:resource="https://w3id.org/ieee7007/nep#nepAgent"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ieee7007/evm#evmascribes -->

    <owl:ObjectProperty rdf:about="https://w3id.org/ieee7007/evm#evmascribes">
        <rdfs:domain rdf:resource="https://w3id.org/ieee7007/nep#nepAgent"/>
        <rdfs:range rdf:resource="https://w3id.org/ieee7007/evm#evmResponsibilityAscription"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ieee7007/evm#evmascribes_distributed_responsibility_in -->

    <owl:ObjectProperty rdf:about="https://w3id.org/ieee7007/evm#evmascribes_distributed_responsibility_in">
        <rdfs:domain rdf:resource="https://w3id.org/ieee7007/evm#evmResponsibilityAscription"/>
        <rdfs:range rdf:resource="https://w3id.org/ieee7007/evm#evmResponsibilityAscription"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ieee7007/evm#evmcause -->

    <owl:ObjectProperty rdf:about="https://w3id.org/ieee7007/evm#evmcause">
        <rdfs:domain rdf:resource="https://w3id.org/ieee7007/evm#evmEventCausation"/>
        <rdfs:range rdf:resource="https://w3id.org/ieee7007/nep#nepAgentAction"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ieee7007/evm#evmcomposed_of -->

    <owl:ObjectProperty rdf:about="https://w3id.org/ieee7007/evm#evmcomposed_of">
        <rdfs:domain rdf:resource="https://w3id.org/ieee7007/evm#evmAscriptionJustification"/>
        <rdfs:range rdf:resource="https://w3id.org/ieee7007/evm#evmGroundsForAscription"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ieee7007/evm#evmcontributes_to -->

    <owl:ObjectProperty rdf:about="https://w3id.org/ieee7007/evm#evmcontributes_to">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/ieee7007/evm#evmAgentAccountability"/>
                    <rdf:Description rdf:about="https://w3id.org/ieee7007/evm#evmEventCausation"/>
                    <rdf:Description rdf:about="https://w3id.org/ieee7007/evm#evmNormViolationIncident"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="https://w3id.org/ieee7007/evm#evmGroundsForAscription"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ieee7007/evm#evmdetects -->

    <owl:ObjectProperty rdf:about="https://w3id.org/ieee7007/evm#evmdetects">
        <rdfs:domain rdf:resource="https://w3id.org/ieee7007/evm#evmEthicalBehaviorMonitor"/>
        <rdfs:range rdf:resource="https://w3id.org/ieee7007/evm#evmNormViolation"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ieee7007/evm#evmdocumented_in -->

    <owl:ObjectProperty rdf:about="https://w3id.org/ieee7007/evm#evmdocumented_in">
        <rdfs:domain rdf:resource="https://w3id.org/ieee7007/evm#evmNormViolation"/>
        <rdfs:range rdf:resource="https://w3id.org/ieee7007/evm#evmNormViolationIncident"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ieee7007/evm#evmeffect -->

    <owl:ObjectProperty rdf:about="https://w3id.org/ieee7007/evm#evmeffect">
        <rdfs:domain rdf:resource="https://w3id.org/ieee7007/evm#evmEventCausation"/>
        <rdfs:range rdf:resource="https://w3id.org/ieee7007/evm#evmNormViolation"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ieee7007/evm#evmelicits -->

    <owl:ObjectProperty rdf:about="https://w3id.org/ieee7007/evm#evmelicits">
        <rdfs:domain rdf:resource="https://w3id.org/ieee7007/evm#evmNormViolation"/>
        <rdfs:range rdf:resource="https://w3id.org/ieee7007/evm#evmResponsibilityAscription"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ieee7007/evm#evmhas_achieved -->

    <owl:ObjectProperty rdf:about="https://w3id.org/ieee7007/evm#evmhas_achieved">
        <rdfs:domain rdf:resource="https://w3id.org/ieee7007/nep#nepGovernment"/>
        <rdfs:range rdf:resource="https://w3id.org/ieee7007/evm#evmSocioTechnologyGovernance"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ieee7007/evm#evmimposes -->

    <owl:ObjectProperty rdf:about="https://w3id.org/ieee7007/evm#evmimposes">
        <rdfs:domain rdf:resource="https://w3id.org/ieee7007/nep#nepAgentRole"/>
        <rdfs:range rdf:resource="https://w3id.org/ieee7007/evm#evmAgentAccountability"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ieee7007/evm#evmis_ascribed_to -->

    <owl:ObjectProperty rdf:about="https://w3id.org/ieee7007/evm#evmis_ascribed_to">
        <rdfs:domain rdf:resource="https://w3id.org/ieee7007/evm#evmResponsibilityAscription"/>
        <rdfs:range rdf:resource="https://w3id.org/ieee7007/nep#nepAgent"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ieee7007/evm#evmis_jurisdiction_of -->

    <owl:ObjectProperty rdf:about="https://w3id.org/ieee7007/evm#evmis_jurisdiction_of">
        <rdfs:domain rdf:resource="https://w3id.org/ieee7007/nep#nepGovernment"/>
        <rdfs:range rdf:resource="https://w3id.org/ieee7007/nep#nepAgent"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ieee7007/evm#evmis_sanction_for -->

    <owl:ObjectProperty rdf:about="https://w3id.org/ieee7007/evm#evmis_sanction_for">
        <rdfs:domain rdf:resource="https://w3id.org/ieee7007/evm#evmLiabilitySanction"/>
        <rdfs:range rdf:resource="https://w3id.org/ieee7007/evm#evmLegalResponsibilityAscription"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ieee7007/evm#evmis_violation_of -->

    <owl:ObjectProperty rdf:about="https://w3id.org/ieee7007/evm#evmis_violation_of">
        <rdfs:domain rdf:resource="https://w3id.org/ieee7007/evm#evmNormViolation"/>
        <rdfs:range rdf:resource="https://w3id.org/ieee7007/nep#nepNorm"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ieee7007/evm#evmjustifies -->

    <owl:ObjectProperty rdf:about="https://w3id.org/ieee7007/evm#evmjustifies">
        <rdfs:domain rdf:resource="https://w3id.org/ieee7007/evm#evmAscriptionJustification"/>
        <rdfs:range rdf:resource="https://w3id.org/ieee7007/evm#evmResponsibilityAscription"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ieee7007/evm#evmmaturity -->

    <owl:ObjectProperty rdf:about="https://w3id.org/ieee7007/evm#evmmaturity">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/ieee7007/evm#evmSocioTechnologyGovernance"/>
        <rdfs:range rdf:resource="https://w3id.org/ieee7007/evm#evmgovernance_levels"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ieee7007/evm#evmmay_be_sanctioned_with -->

    <owl:ObjectProperty rdf:about="https://w3id.org/ieee7007/evm#evmmay_be_sanctioned_with">
        <rdfs:domain rdf:resource="https://w3id.org/ieee7007/nep#nepAgent"/>
        <rdfs:range rdf:resource="https://w3id.org/ieee7007/evm#evmLiabilitySanction"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ieee7007/evm#evmmay_prescribe -->

    <owl:ObjectProperty rdf:about="https://w3id.org/ieee7007/evm#evmmay_prescribe">
        <rdfs:domain rdf:resource="https://w3id.org/ieee7007/evm#evmLegalResponsibilityAscription"/>
        <rdfs:range rdf:resource="https://w3id.org/ieee7007/evm#evmLiabilitySanction"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ieee7007/evm#evmobserves -->

    <owl:ObjectProperty rdf:about="https://w3id.org/ieee7007/evm#evmobserves">
        <rdfs:domain rdf:resource="https://w3id.org/ieee7007/evm#evmEthicalBehaviorMonitor"/>
        <rdfs:range rdf:resource="https://w3id.org/ieee7007/nep#nepAgent"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ieee7007/evm#evmperceived_in -->

    <owl:ObjectProperty rdf:about="https://w3id.org/ieee7007/evm#evmperceived_in">
        <rdfs:domain rdf:resource="https://w3id.org/ieee7007/tlo#tloActionEvent"/>
        <rdfs:range rdf:resource="https://w3id.org/ieee7007/nep#nepSituation"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ieee7007/evm#evmrecords_incidence_of -->

    <owl:ObjectProperty rdf:about="https://w3id.org/ieee7007/evm#evmrecords_incidence_of">
        <rdfs:domain rdf:resource="https://w3id.org/ieee7007/evm#evmNormViolationIncident"/>
        <rdfs:range rdf:resource="https://w3id.org/ieee7007/evm#evmNormViolation"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ieee7007/evm#evmscope -->

    <owl:ObjectProperty rdf:about="https://w3id.org/ieee7007/evm#evmscope">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/ieee7007/evm#evmResponsibilityAscription"/>
        <rdfs:range rdf:resource="https://w3id.org/ieee7007/evm#evmresponsibility_extent"/>
    </owl:ObjectProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- https://w3id.org/ieee7007/evm#evmAccountablePerson -->

    <owl:Class rdf:about="https://w3id.org/ieee7007/evm#evmAccountablePerson">
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/ieee7007/nep#nepAgent"/>
                    <owl:Class>
                        <owl:complementOf rdf:resource="https://w3id.org/ieee7007/nep#nepRobot"/>
                    </owl:Class>
                    <owl:Restriction>
                        <owl:onProperty>
                            <rdf:Description>
                                <owl:inverseOf rdf:resource="https://w3id.org/ieee7007/evm#evmis_ascribed_to"/>
                            </rdf:Description>
                        </owl:onProperty>
                        <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
                        <owl:onClass rdf:resource="https://w3id.org/ieee7007/evm#evmResponsibilityAscription"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <rdfs:comment>helper class for mapping CLIF axioms</rdfs:comment>
    </owl:Class>
    


    <!-- https://w3id.org/ieee7007/evm#evmAgentAccountability -->

    <owl:Class rdf:about="https://w3id.org/ieee7007/evm#evmAgentAccountability">
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/ieee7007/tlo#tloSchema"/>
                    <owl:Restriction>
                        <owl:onProperty>
                            <rdf:Description>
                                <owl:inverseOf rdf:resource="https://w3id.org/ieee7007/evm#evmimposes"/>
                            </rdf:Description>
                        </owl:onProperty>
                        <owl:someValuesFrom rdf:resource="https://w3id.org/ieee7007/nep#nepAgentRole"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- https://w3id.org/ieee7007/evm#evmAscriptionJustification -->

    <owl:Class rdf:about="https://w3id.org/ieee7007/evm#evmAscriptionJustification">
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/ieee7007/tlo#tloInformationArtifact"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://w3id.org/ieee7007/evm#evmjustifies"/>
                        <owl:someValuesFrom rdf:resource="https://w3id.org/ieee7007/evm#evmResponsibilityAscription"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty>
                            <rdf:Description>
                                <owl:inverseOf rdf:resource="https://w3id.org/ieee7007/tlo#tloformulates"/>
                            </rdf:Description>
                        </owl:onProperty>
                        <owl:someValuesFrom rdf:resource="https://w3id.org/ieee7007/nep#nepAgent"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://w3id.org/ieee7007/evm#evmcomposed_of"/>
                        <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
                        <owl:onClass rdf:resource="https://w3id.org/ieee7007/evm#evmGroundsForAscription"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- https://w3id.org/ieee7007/evm#evmDistributedResponsibility -->

    <owl:Class rdf:about="https://w3id.org/ieee7007/evm#evmDistributedResponsibility">
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/ieee7007/evm#evmResponsibilityAscription"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://w3id.org/ieee7007/evm#evmscope"/>
                        <owl:hasValue rdf:resource="https://w3id.org/ieee7007/evm#evmmulti_agents"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://w3id.org/ieee7007/evm#evmascribes_distributed_responsibility_in"/>
                        <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
                        <owl:onClass rdf:resource="https://w3id.org/ieee7007/evm#evmResponsibilityAscription"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <rdfs:comment>helper class for mapping CLIF axioms</rdfs:comment>
    </owl:Class>
    


    <!-- https://w3id.org/ieee7007/evm#evmEnumDataTypes -->

    <owl:Class rdf:about="https://w3id.org/ieee7007/evm#evmEnumDataTypes">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ieee7007/tlo#tloEnumDataTypes"/>
    </owl:Class>
    


    <!-- https://w3id.org/ieee7007/evm#evmEthicalBehaviorMonitor -->

    <owl:Class rdf:about="https://w3id.org/ieee7007/evm#evmEthicalBehaviorMonitor">
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/ieee7007/tlo#tloevmObject"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://w3id.org/ieee7007/evm#evmobserves"/>
                        <owl:someValuesFrom rdf:resource="https://w3id.org/ieee7007/nep#nepAgent"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://w3id.org/ieee7007/evm#evmdetects"/>
                        <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minQualifiedCardinality>
                        <owl:onClass rdf:resource="https://w3id.org/ieee7007/evm#evmNormViolation"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- https://w3id.org/ieee7007/evm#evmEthicalResponsibilityAscription -->

    <owl:Class rdf:about="https://w3id.org/ieee7007/evm#evmEthicalResponsibilityAscription">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ieee7007/evm#evmResponsibilityAscription"/>
        <owl:disjointWith rdf:resource="https://w3id.org/ieee7007/evm#evmLegalResponsibilityAscription"/>
    </owl:Class>
    


    <!-- https://w3id.org/ieee7007/evm#evmEventCausation -->

    <owl:Class rdf:about="https://w3id.org/ieee7007/evm#evmEventCausation">
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/ieee7007/tlo#tloInteractionProcess"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://w3id.org/ieee7007/evm#evmactor"/>
                        <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
                        <owl:onClass rdf:resource="https://w3id.org/ieee7007/nep#nepAgent"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://w3id.org/ieee7007/evm#evmcause"/>
                        <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
                        <owl:onClass rdf:resource="https://w3id.org/ieee7007/nep#nepAgentAction"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://w3id.org/ieee7007/evm#evmeffect"/>
                        <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
                        <owl:onClass rdf:resource="https://w3id.org/ieee7007/evm#evmNormViolation"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- https://w3id.org/ieee7007/evm#evmGroundsForAscription -->

    <owl:Class rdf:about="https://w3id.org/ieee7007/evm#evmGroundsForAscription">
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/ieee7007/tlo#tloInformationArtifact"/>
                    <owl:Restriction>
                        <owl:onProperty>
                            <rdf:Description>
                                <owl:inverseOf rdf:resource="https://w3id.org/ieee7007/evm#evmcontributes_to"/>
                            </rdf:Description>
                        </owl:onProperty>
                        <owl:someValuesFrom rdf:resource="https://w3id.org/ieee7007/evm#evmAgentAccountability"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty>
                            <rdf:Description>
                                <owl:inverseOf rdf:resource="https://w3id.org/ieee7007/evm#evmcontributes_to"/>
                            </rdf:Description>
                        </owl:onProperty>
                        <owl:someValuesFrom rdf:resource="https://w3id.org/ieee7007/evm#evmEventCausation"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty>
                            <rdf:Description>
                                <owl:inverseOf rdf:resource="https://w3id.org/ieee7007/evm#evmcontributes_to"/>
                            </rdf:Description>
                        </owl:onProperty>
                        <owl:someValuesFrom rdf:resource="https://w3id.org/ieee7007/evm#evmNormViolationIncident"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- https://w3id.org/ieee7007/evm#evmLegalResponsibilityAscription -->

    <owl:Class rdf:about="https://w3id.org/ieee7007/evm#evmLegalResponsibilityAscription">
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/ieee7007/evm#evmResponsibilityAscription"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://w3id.org/ieee7007/evm#evmmay_prescribe"/>
                        <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minQualifiedCardinality>
                        <owl:onClass rdf:resource="https://w3id.org/ieee7007/evm#evmLegalResponsibilityAscription"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- https://w3id.org/ieee7007/evm#evmLiabilitySanction -->

    <owl:Class rdf:about="https://w3id.org/ieee7007/evm#evmLiabilitySanction">
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/ieee7007/tlo#tloMethod"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://w3id.org/ieee7007/evm#evmis_sanction_for"/>
                        <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minQualifiedCardinality>
                        <owl:onClass rdf:resource="https://w3id.org/ieee7007/evm#evmLegalResponsibilityAscription"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- https://w3id.org/ieee7007/evm#evmNormViolation -->

    <owl:Class rdf:about="https://w3id.org/ieee7007/evm#evmNormViolation">
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/ieee7007/tlo#tloActionEvent"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://w3id.org/ieee7007/evm#evmdocumented_in"/>
                        <owl:someValuesFrom rdf:resource="https://w3id.org/ieee7007/evm#evmNormViolationIncident"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://w3id.org/ieee7007/evm#evmelicits"/>
                        <owl:someValuesFrom rdf:resource="https://w3id.org/ieee7007/evm#evmResponsibilityAscription"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://w3id.org/ieee7007/evm#evmis_violation_of"/>
                        <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
                        <owl:onClass rdf:resource="https://w3id.org/ieee7007/nep#nepNorm"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty>
                            <rdf:Description>
                                <owl:inverseOf rdf:resource="https://w3id.org/ieee7007/evm#evmeffect"/>
                            </rdf:Description>
                        </owl:onProperty>
                        <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
                        <owl:onClass rdf:resource="https://w3id.org/ieee7007/evm#evmEventCausation"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- https://w3id.org/ieee7007/evm#evmNormViolationIncident -->

    <owl:Class rdf:about="https://w3id.org/ieee7007/evm#evmNormViolationIncident">
        <rdfs:subClassOf>
