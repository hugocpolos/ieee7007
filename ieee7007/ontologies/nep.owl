    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- https://w3id.org/ieee7007/nep#ActionRationale -->

    <owl:Class rdf:about="https://w3id.org/ieee7007/nep#ActionRationale">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ieee7007/tlo#Method"/>
    </owl:Class>
    


    <!-- https://w3id.org/ieee7007/nep#nepAgent -->

    <owl:Class rdf:about="https://w3id.org/ieee7007/nep#nepAgent">
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/ieee7007/tlo#tloAgent"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://w3id.org/ieee7007/tlo#enacts"/>
                        <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minQualifiedCardinality>
                        <owl:onClass rdf:resource="https://w3id.org/ieee7007/nep#AgentRole"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://w3id.org/ieee7007/tlo#is_member_of"/>
                        <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
                        <owl:onClass rdf:resource="https://w3id.org/ieee7007/nep#SocialCollection"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- https://w3id.org/ieee7007/nep#AgentAction -->

    <owl:Class rdf:about="https://w3id.org/ieee7007/nep#AgentAction">
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/ieee7007/tlo#Process"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://w3id.org/ieee7007/tlo#affects"/>
                        <owl:someValuesFrom rdf:resource="https://w3id.org/ieee7007/nep#Environment"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- https://w3id.org/ieee7007/nep#AgentPlan -->

    <owl:Class rdf:about="https://w3id.org/ieee7007/nep#AgentPlan">
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/ieee7007/tlo#InformationArtifact"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://w3id.org/ieee7007/nep#subscribes_to"/>
                        <owl:someValuesFrom rdf:resource="https://w3id.org/ieee7007/nep#EthicalTheory"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://w3id.org/ieee7007/tlo#renders"/>
                        <owl:someValuesFrom rdf:resource="https://w3id.org/ieee7007/tlo#Plan"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://w3id.org/ieee7007/nep#contains"/>
                        <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
                        <owl:onClass rdf:resource="https://w3id.org/ieee7007/nep#PlanAction"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://w3id.org/ieee7007/nep#satisfies"/>
                        <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
                        <owl:onClass rdf:resource="https://w3id.org/ieee7007/nep#Norm"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
