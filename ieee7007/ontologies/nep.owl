                                                            </rdf:Description>
                                                        </rdf:first>
                                                        <rdf:rest>
                                                            <rdf:Description>
                                                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                                                                <rdf:first>
                                                                    <rdf:Description>
                                                                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/>
                                                                        <swrl:propertyPredicate rdf:resource="https://w3id.org/ieee7007/nep#nepis_perception_of"/>
                                                                        <swrl:argument1 rdf:resource="urn:swrl:var#s"/>
                                                                        <swrl:argument2 rdf:resource="urn:swrl:var#e"/>
                                                                    </rdf:Description>
                                                                </rdf:first>
                                                                <rdf:rest>
                                                                    <rdf:Description>
                                                                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                                                                        <rdf:first>
                                                                            <rdf:Description>
                                                                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/>
                                                                                <swrl:propertyPredicate rdf:resource="https://w3id.org/ieee7007/nep#nepis_perceived_by"/>
                                                                                <swrl:argument1 rdf:resource="urn:swrl:var#e"/>
                                                                                <swrl:argument2 rdf:resource="urn:swrl:var#a"/>
                                                                            </rdf:Description>
                                                                        </rdf:first>
                                                                        <rdf:rest>
                                                                            <rdf:Description>
                                                                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                                                                                <rdf:first>
                                                                                    <rdf:Description>
                                                                                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/>
                                                                                        <swrl:propertyPredicate rdf:resource="https://w3id.org/ieee7007/nep#nepintends_to_realize"/>
                                                                                        <swrl:argument1 rdf:resource="urn:swrl:var#a"/>
                                                                                        <swrl:argument2 rdf:resource="urn:swrl:var#s"/>
                                                                                    </rdf:Description>
                                                                                </rdf:first>
                                                                                <rdf:rest>
                                                                                    <rdf:Description>
                                                                                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                                                                                        <rdf:first>
                                                                                            <rdf:Description>
                                                                                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/>
                                                                                                <swrl:propertyPredicate rdf:resource="https://w3id.org/ieee7007/nep#nepcontains"/>
                                                                                                <swrl:argument1 rdf:resource="urn:swrl:var#ap"/>
                                                                                                <swrl:argument2 rdf:resource="urn:swrl:var#pa"/>
                                                                                            </rdf:Description>
                                                                                        </rdf:first>
                                                                                        <rdf:rest>
                                                                                            <rdf:Description>
                                                                                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                                                                                                <rdf:first>
                                                                                                    <rdf:Description>
                                                                                                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/>
                                                                                                        <swrl:propertyPredicate rdf:resource="https://w3id.org/ieee7007/nep#nepis_implemented_by"/>
                                                                                                        <swrl:argument1 rdf:resource="urn:swrl:var#pa"/>
                                                                                                        <swrl:argument2 rdf:resource="urn:swrl:var#ac"/>
                                                                                                    </rdf:Description>
                                                                                                </rdf:first>
                                                                                                <rdf:rest>
                                                                                                    <rdf:Description>
                                                                                                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                                                                                                        <rdf:first>
                                                                                                            <rdf:Description>
                                                                                                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#IndividualPropertyAtom"/>
                                                                                                                <swrl:propertyPredicate rdf:resource="https://w3id.org/ieee7007/tlo#tloaffects"/>
                                                                                                                <swrl:argument1 rdf:resource="urn:swrl:var#ac"/>
                                                                                                                <swrl:argument2 rdf:resource="urn:swrl:var#e"/>
                                                                                                            </rdf:Description>
                                                                                                        </rdf:first>
                                                                                                        <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                                                                                                    </rdf:Description>
                                                                                                </rdf:rest>
                                                                                            </rdf:Description>
                                                                                        </rdf:rest>
                                                                                    </rdf:Description>
                                                                                </rdf:rest>
                                                                            </rdf:Description>
                                                                        </rdf:rest>
                                                                    </rdf:Description>
                                                                </rdf:rest>
                                                            </rdf:Description>
                                                        </rdf:rest>
                                                    </rdf:Description>
                                                </rdf:rest>
                                            </rdf:Description>
                                        </rdf:rest>
                                    </rdf:Description>
                                </rdf:rest>
                            </rdf:Description>
                        </rdf:rest>
                    </rdf:Description>
                </rdf:rest>
            </rdf:Description>
        </swrl:body>
        <swrl:head>
            <rdf:Description>
                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
