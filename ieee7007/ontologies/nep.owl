    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- https://w3id.org/ieee7007/nep#nepActionRationale -->

    <owl:Class rdf:about="https://w3id.org/ieee7007/nep#nepActionRationale">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ieee7007/tlo#tloMethod"/>
    </owl:Class>
    


    <!-- https://w3id.org/ieee7007/nep#nepAgent -->

    <owl:Class rdf:about="https://w3id.org/ieee7007/nep#nepAgent">
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/ieee7007/tlo#tloAgent"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://w3id.org/ieee7007/tlo#tloenacts"/>
                        <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minQualifiedCardinality>
                        <owl:onClass rdf:resource="https://w3id.org/ieee7007/nep#nepAgentRole"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://w3id.org/ieee7007/tlo#tlois_member_of"/>
                        <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
                        <owl:onClass rdf:resource="https://w3id.org/ieee7007/nep#nepSocialCollection"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- https://w3id.org/ieee7007/nep#nepAgentAction -->

    <owl:Class rdf:about="https://w3id.org/ieee7007/nep#nepAgentAction">
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/ieee7007/tlo#tloProcess"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://w3id.org/ieee7007/tlo#tloaffects"/>
                        <owl:someValuesFrom rdf:resource="https://w3id.org/ieee7007/nep#nepEnvironment"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- https://w3id.org/ieee7007/nep#nepAgentPlan -->

    <owl:Class rdf:about="https://w3id.org/ieee7007/nep#nepAgentPlan">
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/ieee7007/tlo#tloInformationArtifact"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://w3id.org/ieee7007/nep#nepsubscribes_to"/>
                        <owl:someValuesFrom rdf:resource="https://w3id.org/ieee7007/nep#nepEthicalTheory"/>
