                                            <rdf:Description>
                                                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#ClassAtom"/>
                                                <swrl:classPredicate rdf:resource="https://w3id.org/ieee7007/nep#AgentAction"/>
                                                <swrl:argument1 rdf:resource="urn:swrl:var#ac"/>
                                            </rdf:Description>
                                        </rdf:first>
                                        <rdf:rest>
