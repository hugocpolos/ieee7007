        <rdfs:range rdf:resource="https://w3id.org/ieee7007/tlo#Physical"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ieee7007/tlo#created_by -->

    <owl:ObjectProperty rdf:about="https://w3id.org/ieee7007/tlo#created_by">
        <owl:inverseOf rdf:resource="https://w3id.org/ieee7007/tlo#creates"/>
        <rdfs:domain rdf:resource="https://w3id.org/ieee7007/tlo#ActionEvent"/>
        <rdfs:range rdf:resource="https://w3id.org/ieee7007/tlo#tloAgent"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ieee7007/tlo#creates -->

    <owl:ObjectProperty rdf:about="https://w3id.org/ieee7007/tlo#creates">
