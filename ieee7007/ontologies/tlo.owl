    <!-- https://w3id.org/ieee7007/tlo#tloAbstract -->

    <owl:Class rdf:about="https://w3id.org/ieee7007/tlo#tloAbstract">
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/ieee7007/tlo#tloEntity"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://w3id.org/ieee7007/tlo#tlocharacterizes"/>
                        <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minQualifiedCardinality>
                        <owl:onClass rdf:resource="https://w3id.org/ieee7007/tlo#tloPhysical"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <owl:disjointWith rdf:resource="https://w3id.org/ieee7007/tlo#tloPhysical"/>
    </owl:Class>
    


    <!-- https://w3id.org/ieee7007/tlo#tloActionEvent -->

    <owl:Class rdf:about="https://w3id.org/ieee7007/tlo#tloActionEvent">
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/ieee7007/tlo#tloEvent"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://w3id.org/ieee7007/tlo#tlocreated_by"/>
                        <owl:someValuesFrom rdf:resource="https://w3id.org/ieee7007/tlo#tloAgent"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <owl:disjointWith rdf:resource="https://w3id.org/ieee7007/tlo#tloEnvironmentalEvent"/>
    </owl:Class>
    


