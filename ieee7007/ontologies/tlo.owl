        <rdfs:range rdf:resource="https://w3id.org/ieee7007/tlo#Time"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ieee7007/tlo#formulatedBy -->

    <owl:ObjectProperty rdf:about="https://w3id.org/ieee7007/tlo#formulatedBy">
        <owl:inverseOf rdf:resource="https://w3id.org/ieee7007/tlo#formulates"/>
        <rdfs:domain rdf:resource="https://w3id.org/ieee7007/tlo#InformationArtifact"/>
        <rdfs:range rdf:resource="https://w3id.org/ieee7007/tlo#tloAgent"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ieee7007/tlo#formulates -->

    <owl:ObjectProperty rdf:about="https://w3id.org/ieee7007/tlo#formulates">
        <rdfs:domain rdf:resource="https://w3id.org/ieee7007/tlo#tloAgent"/>
        <rdfs:range rdf:resource="https://w3id.org/ieee7007/tlo#InformationArtifact"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ieee7007/tlo#hasMember -->

    <owl:ObjectProperty rdf:about="https://w3id.org/ieee7007/tlo#hasMember">
        <owl:inverseOf rdf:resource="https://w3id.org/ieee7007/tlo#is_member_of"/>
        <rdfs:domain rdf:resource="https://w3id.org/ieee7007/tlo#Collective"/>
        <rdfs:range rdf:resource="https://w3id.org/ieee7007/tlo#Entity"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ieee7007/tlo#hasParticipant -->

    <owl:ObjectProperty rdf:about="https://w3id.org/ieee7007/tlo#hasParticipant">
        <owl:inverseOf rdf:resource="https://w3id.org/ieee7007/tlo#participates_in"/>
        <rdfs:domain rdf:resource="https://w3id.org/ieee7007/tlo#Process"/>
        <rdfs:range rdf:resource="https://w3id.org/ieee7007/tlo#evmObject"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ieee7007/tlo#identified_at -->

    <owl:ObjectProperty rdf:about="https://w3id.org/ieee7007/tlo#identified_at">
        <rdfs:domain rdf:resource="https://w3id.org/ieee7007/tlo#Physical"/>
        <rdfs:range rdf:resource="https://w3id.org/ieee7007/tlo#Time"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ieee7007/tlo#identified_by -->

    <owl:ObjectProperty rdf:about="https://w3id.org/ieee7007/tlo#identified_by">
        <rdfs:domain rdf:resource="https://w3id.org/ieee7007/tlo#Physical"/>
        <rdfs:range rdf:resource="https://w3id.org/ieee7007/tlo#Property"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ieee7007/tlo#isRealizedBy -->

    <owl:ObjectProperty rdf:about="https://w3id.org/ieee7007/tlo#isRealizedBy">
        <owl:inverseOf rdf:resource="https://w3id.org/ieee7007/tlo#realizes"/>
        <rdfs:domain rdf:resource="https://w3id.org/ieee7007/tlo#Method"/>
        <rdfs:range rdf:resource="https://w3id.org/ieee7007/tlo#Process"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ieee7007/tlo#is_member_of -->

    <owl:ObjectProperty rdf:about="https://w3id.org/ieee7007/tlo#is_member_of">
        <rdfs:domain rdf:resource="https://w3id.org/ieee7007/tlo#Entity"/>
        <rdfs:range rdf:resource="https://w3id.org/ieee7007/tlo#Collective"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ieee7007/tlo#is_stage_at -->

    <owl:ObjectProperty rdf:about="https://w3id.org/ieee7007/tlo#is_stage_at">
        <rdfs:domain rdf:resource="https://w3id.org/ieee7007/tlo#Process"/>
        <rdfs:range rdf:resource="https://w3id.org/ieee7007/tlo#Time"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ieee7007/tlo#is_stage_of -->

    <owl:ObjectProperty rdf:about="https://w3id.org/ieee7007/tlo#is_stage_of">
        <rdfs:domain rdf:resource="https://w3id.org/ieee7007/tlo#Process"/>
        <rdfs:range rdf:resource="https://w3id.org/ieee7007/tlo#Process"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ieee7007/tlo#located_at -->

    <owl:ObjectProperty rdf:about="https://w3id.org/ieee7007/tlo#located_at">
        <rdfs:domain rdf:resource="https://w3id.org/ieee7007/tlo#Physical"/>
        <rdfs:range rdf:resource="https://w3id.org/ieee7007/tlo#SpatioTemporalPlace"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ieee7007/tlo#manifests -->

    <owl:ObjectProperty rdf:about="https://w3id.org/ieee7007/tlo#manifests">
        <owl:inverseOf rdf:resource="https://w3id.org/ieee7007/tlo#occurs_in"/>
        <rdfs:domain rdf:resource="https://w3id.org/ieee7007/tlo#Process"/>
        <rdfs:range rdf:resource="https://w3id.org/ieee7007/tlo#Event"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ieee7007/tlo#occurs_in -->

    <owl:ObjectProperty rdf:about="https://w3id.org/ieee7007/tlo#occurs_in">
        <rdfs:domain rdf:resource="https://w3id.org/ieee7007/tlo#Event"/>
        <rdfs:range rdf:resource="https://w3id.org/ieee7007/tlo#Process"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ieee7007/tlo#participates_in -->

    <owl:ObjectProperty rdf:about="https://w3id.org/ieee7007/tlo#participates_in">
        <rdfs:domain rdf:resource="https://w3id.org/ieee7007/tlo#evmObject"/>
        <rdfs:range rdf:resource="https://w3id.org/ieee7007/tlo#Process"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ieee7007/tlo#perceived_by -->

    <owl:ObjectProperty rdf:about="https://w3id.org/ieee7007/tlo#perceived_by">
        <rdfs:domain rdf:resource="https://w3id.org/ieee7007/tlo#Entity"/>
        <rdfs:range rdf:resource="https://w3id.org/ieee7007/tlo#tloAgent"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ieee7007/tlo#present_at -->

    <owl:ObjectProperty rdf:about="https://w3id.org/ieee7007/tlo#present_at">
        <rdfs:domain rdf:resource="https://w3id.org/ieee7007/tlo#Physical"/>
        <rdfs:range rdf:resource="https://w3id.org/ieee7007/tlo#Time"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ieee7007/tlo#property_of -->

    <owl:ObjectProperty rdf:about="https://w3id.org/ieee7007/tlo#property_of">
        <rdfs:domain rdf:resource="https://w3id.org/ieee7007/tlo#Property"/>
        <rdfs:range rdf:resource="https://w3id.org/ieee7007/tlo#Entity"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ieee7007/tlo#realizes -->

    <owl:ObjectProperty rdf:about="https://w3id.org/ieee7007/tlo#realizes">
        <rdfs:domain rdf:resource="https://w3id.org/ieee7007/tlo#Process"/>
        <rdfs:range rdf:resource="https://w3id.org/ieee7007/tlo#Method"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ieee7007/tlo#renders -->

    <owl:ObjectProperty rdf:about="https://w3id.org/ieee7007/tlo#renders">
        <rdfs:domain rdf:resource="https://w3id.org/ieee7007/tlo#InformationArtifact"/>
        <rdfs:range rdf:resource="https://w3id.org/ieee7007/tlo#Abstract"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ieee7007/tlo#selected_by -->

    <owl:ObjectProperty rdf:about="https://w3id.org/ieee7007/tlo#selected_by">
        <rdfs:domain rdf:resource="https://w3id.org/ieee7007/tlo#Plan"/>
        <rdfs:range rdf:resource="https://w3id.org/ieee7007/tlo#tloAgent"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ieee7007/tlo#start_time -->

    <owl:ObjectProperty rdf:about="https://w3id.org/ieee7007/tlo#start_time">
        <rdfs:domain rdf:resource="https://w3id.org/ieee7007/tlo#Event"/>
        <rdfs:range rdf:resource="https://w3id.org/ieee7007/tlo#Time"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ieee7007/tlo#transmits -->

    <owl:ObjectProperty rdf:about="https://w3id.org/ieee7007/tlo#transmits">
        <owl:inverseOf rdf:resource="https://w3id.org/ieee7007/tlo#transmitted_by"/>
        <rdfs:domain rdf:resource="https://w3id.org/ieee7007/tlo#AgentCommunication"/>
        <rdfs:range rdf:resource="https://w3id.org/ieee7007/tlo#InformationArtifact"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ieee7007/tlo#transmitted_by -->

    <owl:ObjectProperty rdf:about="https://w3id.org/ieee7007/tlo#transmitted_by">
        <rdfs:domain rdf:resource="https://w3id.org/ieee7007/tlo#InformationArtifact"/>
        <rdfs:range rdf:resource="https://w3id.org/ieee7007/tlo#AgentCommunication"/>
    </owl:ObjectProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- https://w3id.org/ieee7007/tlo#Abstract -->

    <owl:Class rdf:about="https://w3id.org/ieee7007/tlo#Abstract">
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/ieee7007/tlo#Entity"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://w3id.org/ieee7007/tlo#characterizes"/>
                        <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minQualifiedCardinality>
                        <owl:onClass rdf:resource="https://w3id.org/ieee7007/tlo#Physical"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <owl:disjointWith rdf:resource="https://w3id.org/ieee7007/tlo#Physical"/>
    </owl:Class>
    


    <!-- https://w3id.org/ieee7007/tlo#ActionEvent -->

    <owl:Class rdf:about="https://w3id.org/ieee7007/tlo#ActionEvent">
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/ieee7007/tlo#Event"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://w3id.org/ieee7007/tlo#created_by"/>
                        <owl:someValuesFrom rdf:resource="https://w3id.org/ieee7007/tlo#tloAgent"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <owl:disjointWith rdf:resource="https://w3id.org/ieee7007/tlo#EnvironmentalEvent"/>
    </owl:Class>
    


    <!-- https://w3id.org/ieee7007/tlo#tloAgent -->

    <owl:Class rdf:about="https://w3id.org/ieee7007/tlo#tloAgent">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ieee7007/tlo#evmObject"/>
    </owl:Class>
    


    <!-- https://w3id.org/ieee7007/tlo#AgentCommunication -->

    <owl:Class rdf:about="https://w3id.org/ieee7007/tlo#AgentCommunication">
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/ieee7007/tlo#ActionEvent"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://w3id.org/ieee7007/tlo#transmits"/>
                        <owl:someValuesFrom rdf:resource="https://w3id.org/ieee7007/tlo#InformationArtifact"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- https://w3id.org/ieee7007/tlo#Attribute -->

    <owl:Class rdf:about="https://w3id.org/ieee7007/tlo#Attribute">
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/ieee7007/tlo#Property"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://w3id.org/ieee7007/tlo#property_of"/>
                        <owl:someValuesFrom rdf:resource="https://w3id.org/ieee7007/tlo#evmObject"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <owl:disjointWith rdf:resource="https://w3id.org/ieee7007/tlo#Manner"/>
    </owl:Class>
    


    <!-- https://w3id.org/ieee7007/tlo#Collective -->

    <owl:Class rdf:about="https://w3id.org/ieee7007/tlo#Collective">
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/ieee7007/tlo#Abstract"/>
                    <owl:Restriction>
                        <owl:onProperty>
                            <rdf:Description>
                                <owl:inverseOf rdf:resource="https://w3id.org/ieee7007/tlo#describes"/>
                            </rdf:Description>
                        </owl:onProperty>
                        <owl:someValuesFrom rdf:resource="https://w3id.org/ieee7007/tlo#Description"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty>
                            <rdf:Description>
                                <owl:inverseOf rdf:resource="https://w3id.org/ieee7007/tlo#is_member_of"/>
                            </rdf:Description>
                        </owl:onProperty>
                        <owl:someValuesFrom rdf:resource="https://w3id.org/ieee7007/tlo#Entity"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- https://w3id.org/ieee7007/tlo#Continuant -->

    <owl:Class rdf:about="https://w3id.org/ieee7007/tlo#Continuant">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ieee7007/tlo#Physical"/>
        <owl:disjointWith rdf:resource="https://w3id.org/ieee7007/tlo#Occurrent"/>
    </owl:Class>
    


    <!-- https://w3id.org/ieee7007/tlo#Description -->

    <owl:Class rdf:about="https://w3id.org/ieee7007/tlo#Description">
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/ieee7007/tlo#Abstract"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://w3id.org/ieee7007/tlo#describes"/>
                        <owl:someValuesFrom rdf:resource="https://w3id.org/ieee7007/tlo#Entity"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- https://w3id.org/ieee7007/tlo#Entity -->

    <owl:Class rdf:about="https://w3id.org/ieee7007/tlo#Entity">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    </owl:Class>
    


    <!-- https://w3id.org/ieee7007/tlo#tloEnumDataTypes -->

    <owl:Class rdf:about="https://w3id.org/ieee7007/tlo#tloEnumDataTypes">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ieee7007/tlo#Description"/>
    </owl:Class>
    


    <!-- https://w3id.org/ieee7007/tlo#EnvironmentalEvent -->

    <owl:Class rdf:about="https://w3id.org/ieee7007/tlo#EnvironmentalEvent">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ieee7007/tlo#Event"/>
    </owl:Class>
    


    <!-- https://w3id.org/ieee7007/tlo#Event -->

    <owl:Class rdf:about="https://w3id.org/ieee7007/tlo#Event">
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/ieee7007/tlo#Occurrent"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://w3id.org/ieee7007/tlo#end_time"/>
                        <owl:someValuesFrom rdf:resource="https://w3id.org/ieee7007/tlo#Time"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://w3id.org/ieee7007/tlo#occurs_in"/>
                        <owl:someValuesFrom rdf:resource="https://w3id.org/ieee7007/tlo#Process"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://w3id.org/ieee7007/tlo#start_time"/>
                        <owl:someValuesFrom rdf:resource="https://w3id.org/ieee7007/tlo#Time"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- https://w3id.org/ieee7007/tlo#InformationArtifact -->

    <owl:Class rdf:about="https://w3id.org/ieee7007/tlo#InformationArtifact">
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/ieee7007/tlo#evmObject"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://w3id.org/ieee7007/tlo#formulatedBy"/>
                        <owl:someValuesFrom rdf:resource="https://w3id.org/ieee7007/tlo#tloAgent"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- https://w3id.org/ieee7007/tlo#InteractionProcess -->

    <owl:Class rdf:about="https://w3id.org/ieee7007/tlo#InteractionProcess">
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/ieee7007/tlo#Process"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://w3id.org/ieee7007/tlo#hasParticipant"/>
