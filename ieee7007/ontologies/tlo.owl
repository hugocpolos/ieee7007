<?xml version="1.0"?>
<rdf:RDF xmlns="https://w3id.org/ieee7007/tlo#"
     xml:base="https://w3id.org/ieee7007/tlo"
     xmlns:dc="http://purl.org/dc/elements/1.1/"
     xmlns:nep="https://w3id.org/ieee7007/nep#"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:tlo="https://w3id.org/ieee7007/tlo#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#">
    <owl:Ontology rdf:about="https://w3id.org/ieee7007/tlo">
        <owl:versionIRI rdf:resource="https://w3id.org/ieee7007/0.3.0/tlo"/>
        <rdfs:comment>An example mapping of ERAS-TLO CLIF axioms into OWL axioms using Manchester OWL syntax</rdfs:comment>
    </owl:Ontology>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Annotation properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.w3.org/2000/01/rdf-schema#comment -->

    <owl:AnnotationProperty rdf:about="http://www.w3.org/2000/01/rdf-schema#comment"/>
    


