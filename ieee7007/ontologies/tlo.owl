        <rdfs:range rdf:resource="https://w3id.org/ieee7007/tlo#ActionEvent"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ieee7007/tlo#describedBy -->

    <owl:ObjectProperty rdf:about="https://w3id.org/ieee7007/tlo#describedBy">
        <rdfs:domain rdf:resource="https://w3id.org/ieee7007/tlo#Entity"/>
        <rdfs:range rdf:resource="https://w3id.org/ieee7007/tlo#Description"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ieee7007/tlo#describes -->

    <owl:ObjectProperty rdf:about="https://w3id.org/ieee7007/tlo#describes">
        <rdfs:domain rdf:resource="https://w3id.org/ieee7007/tlo#Description"/>
        <rdfs:range rdf:resource="https://w3id.org/ieee7007/tlo#Entity"/>
