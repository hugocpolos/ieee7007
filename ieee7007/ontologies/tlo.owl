        <rdfs:domain rdf:resource="https://w3id.org/ieee7007/tlo#Role"/>
        <rdfs:range rdf:resource="https://w3id.org/ieee7007/tlo#tloAgent"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ieee7007/tlo#enacts -->

    <owl:ObjectProperty rdf:about="https://w3id.org/ieee7007/tlo#enacts">
        <rdfs:domain rdf:resource="https://w3id.org/ieee7007/tlo#tloAgent"/>
        <rdfs:range rdf:resource="https://w3id.org/ieee7007/tlo#Role"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ieee7007/tlo#end_time -->

