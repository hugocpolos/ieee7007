                    <rdf:Description rdf:about="https://w3id.org/ieee7007/tlo#tloProperty"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://w3id.org/ieee7007/tlo#tloproperty_of"/>
                        <owl:someValuesFrom rdf:resource="https://w3id.org/ieee7007/tlo#tloevmObject"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
