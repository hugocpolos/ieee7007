    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- https://w3id.org/ieee7007/tlo#affects -->

    <owl:ObjectProperty rdf:about="https://w3id.org/ieee7007/tlo#affects">
        <rdfs:domain rdf:resource="https://w3id.org/ieee7007/tlo#Process"/>
        <rdfs:range rdf:resource="https://w3id.org/ieee7007/tlo#Physical"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/ieee7007/tlo#characterizes -->

